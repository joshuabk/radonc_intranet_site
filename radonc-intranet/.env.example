# Copy to .env (or set as real environment variables / IIS app settings).
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_ALLOWED_HOSTS=radonc.hospital.internal,10.0.0.50
DJANGO_CSRF_TRUSTED_ORIGINS=http://radonc.hospital.internal

SITE_NAME=Radiation Oncology Intranet
ORG_NAME=Hospital System
TIME_ZONE=America/New_York

# Require sign-in for every page (true/false). When false the whole site is
# open to anyone who can reach it; /admin/ always requires login regardless.
REQUIRE_LOGIN=false

# Application database (PostgreSQL recommended; omit to use SQLite)
#APP_DB_NAME=radonc_intranet
#APP_DB_USER=radonc
#APP_DB_PASSWORD=
#APP_DB_HOST=localhost
#APP_DB_PORT=5432

# ARIA read-only reporting connection (leave unset until approved by Varian DBA)
#ARIA_DB_HOST=
#ARIA_DB_NAME=VARIAN
#ARIA_DB_USER=
#ARIA_DB_PASSWORD=

# MOSAIQ read-only reporting connection
#MOSAIQ_DB_HOST=
#MOSAIQ_DB_NAME=MOSAIQ
#MOSAIQ_DB_USER=
#MOSAIQ_DB_PASSWORD=
